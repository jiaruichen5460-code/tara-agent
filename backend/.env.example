TARA_ENVIRONMENT=development
TARA_API_PREFIX=/api/v1
TARA_DATASET_DIR=../Tara_4_Core_Datasets
TARA_PROCESSED_DATA_DIR=./data/processed
TARA_CORS_ORIGINS=["http://localhost:3000"]
TARA_DATABASE_URL=postgresql+asyncpg://tara_agent:replace-with-a-strong-password@localhost:5432/tara_agent
TARA_DATABASE_POOL_SIZE=5
TARA_DATABASE_MAX_OVERFLOW=10
TARA_DATABASE_POOL_TIMEOUT_SECONDS=30
TARA_AUTH_SESSION_DAYS=7
TARA_AUTH_GUEST_LOGIN_ENABLED=true
TARA_AUTH_GUEST_EMAIL=guest@tara-agent.local
TARA_AUTH_GUEST_DISPLAY_NAME=游客共享空间

DEEPSEEK_API_KEY=replace-with-your-key
TARA_DEEPSEEK_MODEL=deepseek-flash
TARA_DEEPSEEK_REASONING_EFFORT=low
